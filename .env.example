# ==============================================================================
# Kenya NOC multi-agent system — environment reference
# Copy to .env and fill in what you need (NEVER commit .env, never commit secrets)
# ==============================================================================
#
# READ THIS FIRST
#   * Every flag below defaults to OFF unless a line says otherwise.
#   * MOST OF THESE FLAGS NAME FEATURES THAT DO NOT EXIST YET (Phases 1-8 of the
#     build spec). Setting them today does nothing at all — no error, no effect.
#     The ones that ARE read by code shipping right now: the "Core runtime"
#     block immediately below, the email/Gmail block, the whole LLM block
#     (LLM_ENABLED, LLM_PROVIDER, LLM_ALLOW_AUTH_TOKEN, OPENAI_COMPAT_*,
#     LLM_ZDR_CONFIRMED, the timeouts and the budget), LEDGER_DIR,
#     OTEL_EXPORTER_OTLP_ENDPOINT (read by llm/otel.py, which warns that it
#     exports nothing — see its own note below) and
#     NOC_SKIP_DOTENV. The rest is here so the flag
#     surface is reviewable in one place before it is wired up.
#   * Lines are left COMMENTED OUT on purpose: an empty value in a real .env
#     (e.g. SMTP_HOST=) overrides the code's built-in default with "", which
#     breaks things. Uncomment only what you actually set.
#   * NEVER put a real secret in this file. Value slots stay empty.
#
# ------------------------------------------------------------------------------
# Core runtime — READ BY THE CODE TODAY (not in the spec's Appendix B flag list,
# but every one of these is live; see the file:line given for each)
# ------------------------------------------------------------------------------
# OPERATOR_PROFILE=safaricom        # which operator's config/thresholds to load: safaricom | airtel
#                                   # (config.py:133; falls back to config/default.yaml, then "safaricom")
# AUTONOMY_LEVEL=L2_GUARDED         # how much the agents may do unattended. Read at config.py:139;
#                                   # the gate itself is services/composition.py:27 needs_hitl():
#                                   #   L1_COPILOT      = EVERY broadcast waits for a human
#                                   #   L2_GUARDED      = P1 and P2 wait; P3/P4 auto-send   (default)
#                                   #   L3_CONDITIONAL  = only P1 waits; P2/P3/P4 auto-send
# DATABASE_URL=sqlite:///./data/noc_agents.db   # SQLAlchemy URL (config.py:141). Default shown.
# NOC_FRONTEND_DIST=frontend/dist   # where the built SPA is served from (main.py). Default shown;
#                                   # with no build there, GET / answers a page saying how to build it.
# LIVE_AGENT_DELAY_MS=0             # artificial pause between agent steps so a demo audience can
#                                   # watch the workflow animate (instrumentation.py:16). 0 = full speed.
# ANTHROPIC_AUTH_TOKEN=             # WARNING, read before setting this. The G13 subscription guard
#                                   # IS NOW IMPLEMENTED (llm/client.py -> resolve_anthropic_credential):
#                                   # this token is IGNORED unless LLM_ALLOW_AUTH_TOKEN=true, and on its
#                                   # own it is REFUSED with a one-line error — credential_present() reads
#                                   # false, get_llm()/get_llm_port() return None and every route keeps
#                                   # its deterministic template. A Claude subscription token is not a
#                                   # licence for application API access: the app needs a Console
#                                   # ANTHROPIC_API_KEY, which the client is now constructed with
#                                   # EXPLICITLY so the SDK cannot pick up anything else. An OAuth
#                                   # profile in ~/.config/anthropic/ is never used: with no API key
#                                   # present it is refused, citing
#                                   # https://code.claude.com/docs/en/legal-and-compliance.
#                                   # Set this ONLY for an enterprise gateway token, together with
#                                   # LLM_ALLOW_AUTH_TOKEN=true. See docs/AGENTS_MCP_LLM.md ->
#                                   # "Licensing: two lanes".

# ------------------------------------------------------------------------------
# LLM (Phase 2+; assist layer only — templates always work without it)
# ------------------------------------------------------------------------------
# LLM_ENABLED=false                 # master switch for every LLM call; off = templates only
# LLM_PROVIDER=anthropic            # none | anthropic | openai_compat. UNSET = anthropic (what this system
#                                   # has always done when LLM_ENABLED=true; the knob must not silently switch
#                                   # an existing deployment off). An unknown value fails closed to none.
# ANTHROPIC_API_KEY=                # Console API key; required when LLM_PROVIDER=anthropic. Passed to the SDK
#                                   # explicitly — see the ANTHROPIC_AUTH_TOKEN warning above.
# LLM_ALLOW_AUTH_TOKEN=false        # honour ANTHROPIC_AUTH_TOKEN (enterprise gateway ONLY). Default false =
#                                   # a bare auth token is refused, never used as a stand-in for an API key.
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:11434/v1   # local Ollama/OpenAI-compatible endpoint (default shown).
#                                   # Local = zero cost and nothing leaves the box. Groq/Gemini also speak this
#                                   # protocol but are hosted, so that argument does not apply to them.
# OPENAI_COMPAT_MODEL=qwen3:4b      # model name on that endpoint (default shown)
# OPENAI_COMPAT_API_KEY=            # bearer token for a hosted OpenAI-compatible endpoint; a local Ollama needs none
# LLM_PRICES_PATH=                  # override config/llm_prices.yaml (prices are config, not code)
# LLM_TIMEOUT_S=20                  # seconds per drafting call (exec brief), 1..300 (default 20)
# LLM_REASONING_TIMEOUT_S=60        # seconds per reasoning call (incident analysis), 1..300 (default 60)
# LLM_MAX_RETRIES=1                 # retries per LLM call (default 1). Worst case per analysis =
#                                   # (1 + retries) x LLM_REASONING_TIMEOUT_S x 2 models = 240 s at defaults
# LLM_MONTHLY_BUDGET_USD=20         # hard monthly spend ceiling in USD; over budget = fall back to templates (default 20)
# LLM_ZDR_CONFIRMED=false           # assert zero-data-retention is contractually confirmed; set true ONLY with a
#                                   # dated Anthropic confirmation recorded in docs/COMPLIANCE.md
#
# ------------------------------------------------------------------------------
# Scheduler and outbox (Phase 1)
# ------------------------------------------------------------------------------
# SCHEDULER_ENABLED=false           # run the background scheduler loop (SLA chases, recurring jobs)
# SCHEDULER_TICK_SECONDS=5          # seconds between scheduler ticks (default 5)
# SCHEDULER_MONITOR_ENABLED=false   # emit scheduler.job_failed events and lease-health metrics
# OUTBOX_DISPATCH_ENABLED=false     # let the outbox worker actually dispatch queued messages
# OUTBOX_SYNC_DRAIN=true            # DEFAULT ON (graph/pipeline.py sync_drain_enabled). Drains the outbox
#                                   # right after each commit, inside the request, so mail leaves even
#                                   # with the scheduler off -- which is also the default. Turning it off
#                                   # without SCHEDULER_ENABLED=true + OUTBOX_DISPATCH_ENABLED means NO
#                                   # message is ever sent. It is also why the spec's three-flag kill
#                                   # sequence does not stop mail on its own: a freeze must set this to
#                                   # false as well (docs/RUNBOOK.md section 16; CONFORMANCE A-11).
#                                   # This line previously read "=false ... never production", which
#                                   # was the opposite of what the code does.
#
# ------------------------------------------------------------------------------
# Email / Gmail SMTP  (WORKS TODAY)
# ------------------------------------------------------------------------------
# Google Account -> Security -> 2-Step Verification -> App passwords
# Create an app password for "Mail". A normal Gmail password will NOT work.

GMAIL_ADDRESS=your.email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Where demo outage mails go (defaults to GMAIL_ADDRESS if unset)
DEMO_EMAIL_TO=your.email@gmail.com

# Real sending is OPT-IN since Phase 0: the default is false even when credentials
# are present, so a misconfigured box mocks instead of mailing customers.
# Set this to true for the Gmail demo — otherwise every send is a silent mock.
EMAIL_ENABLED=false

# EMAIL_DAILY_CAP=400               # max real sends per day (400 for a free @gmail.com sender; 1600 for Workspace)
#                                   # Counted from real SMTP sends in the last 24 h (mock sends
#                                   # cost nothing). At the cap a P1 is STILL sent -- the cap
#                                   # exists to keep the account alive for the next P1 -- and
#                                   # anything else is deferred until the window rolls, never
#                                   # dropped. 0 turns the cap off; an unparseable value means 400.
# EMAIL_LIST_UNSUBSCRIBE=           # optional List-Unsubscribe header value (a mailto: or https:
#                                   # URL). Unset = no header is invented.
# SMTP_HOST=smtp.gmail.com          # SMTP relay host (default smtp.gmail.com)
# SMTP_PORT=587                     # SMTP port, STARTTLS (default 587)
# SMTP_USER=                        # SMTP username, if not using GMAIL_ADDRESS
# SMTP_PASSWORD=                    # SMTP password / app password, if not using GMAIL_APP_PASSWORD
# SMTP_FROM=                        # envelope From address, if it differs from the SMTP user
#
# ------------------------------------------------------------------------------
# HITL (human in the loop)
# ------------------------------------------------------------------------------
# HITL_APPROVE_REASON_REQUIRED=false  # require a non-empty reason on APPROVE too (rejects always need one).
#                                     # Default false; production sets true.
# HITL_ESCALATION_ENABLED=false       # the §6.5 escalation ladder (scheduler job hitl_escalation, every 60 s;
#                                     # needs SCHEDULER_ENABLED=true). A P1/P2 approval card that sits PENDING
#                                     # and unclaimed gets: T+5 min an internal nudge to the on-duty supervisor
#                                     # (SMS via the mock SMS path + in-app hitl.nudge), T+15 the same to the
#                                     # duty manager plus the WS event hitl.escalated, T+30 red on the Wallboard
#                                     # and a note on the CA 24-h card by regulatory_sweep. Nudges are
#                                     # HITL_NUDGE outbox rows under deterministic keys, so a restart never
#                                     # nudges twice. It NEVER releases, approves, rejects or claims anything
#                                     # (spec D1). Minutes and recipients are YAML: hitl.escalation and
#                                     # notification_recipients.hitl.recipients.* in config/operators/<op>.yaml;
#                                     # both recipient refs ship EMPTY, so the SMS half is recorded SUPPRESSED
#                                     # (never sent to an invented number) until the roster is filled in.
#
# ------------------------------------------------------------------------------
# SMS (Phase 3; Africa's Talking)
# ------------------------------------------------------------------------------
# SMS_ENABLED=false                 # master switch for SMS sending
# SMS_PROVIDER=africastalking       # SMS provider id (default africastalking)
# AT_USERNAME=sandbox               # Africa's Talking username; "sandbox" sends nowhere real (default sandbox)
# AT_API_KEY=                       # Africa's Talking API key
# AT_SENDER_ID=                     # registered alphanumeric sender ID (Kenya requires registration)
#
# ------------------------------------------------------------------------------
# WhatsApp (Phase 3; Meta Cloud API)
# ------------------------------------------------------------------------------
# WHATSAPP_ENABLED=false            # master switch for the WhatsApp adapter
# WHATSAPP_DRAFT_ONLY=true          # DEFAULT TRUE: compose and store, never transmit. Flip to false only
#                                   # once templates are approved and opt-in is verified.
# WHATSAPP_PHONE_NUMBER_ID=         # Meta Cloud API phone number id
# WHATSAPP_ACCESS_TOKEN=            # Meta Graph API access token
# WHATSAPP_APP_SECRET=              # Meta app secret, used to verify inbound webhook signatures
# OPT_IN_SALT=                      # salt for hashing subscriber numbers in the opt-in register
#
# ------------------------------------------------------------------------------
# Weather and power (Phase 3 external signals)
# ------------------------------------------------------------------------------
# WEATHER_ENABLED=false             # pull weather signals for site risk correlation
# WEATHER_PROVIDER=open_meteo       # open_meteo | met_no (default open_meteo)
# WEATHER_API_BASE=https://api.open-meteo.com   # weather API base URL (default shown)
# WEATHER_API_KEY=                  # only needed by providers that require a key (open-meteo does not)
# MET_NO_USER_AGENT=KenyaNOCMissionControl/2.0 (contact@example.com)
#                                   # MET Norway REQUIRES an identifying User-Agent with a contact address
# CAP_STALE_DAYS=7                  # CAP alert older than this many days is treated as stale (default 7)
# KMD_CAP_FEED_URL=https://meteo.go.ke/api/cap/rss.xml   # override the KMD CAP RSS feed (default shown)
# FLOOD_API_BASE=https://flood-api.open-meteo.com          # override the GloFAS flood API base (default shown)
# KPLC_ENABLED=false                # scrape Kenya Power planned-interruption notices
# KPLC_NOTICES_URL=https://kplc.co.ke/customer-support   # KPLC notices page (default shown)
#
# ------------------------------------------------------------------------------
# Social signals (Phase 3; complaint surge detection)
# ------------------------------------------------------------------------------
# SOCIAL_SIGNALS_ENABLED=false      # ingest social/complaint signals at all
# SOCIAL_HASH_SALT=                 # salt for pseudonymising author handles before storage (DPA s.25)
# SOCIAL_SURGE_Z=3.0                # z-score above baseline that counts as a surge (default 3.0)
# SOCIAL_SURGE_MIN_COUNT=5          # minimum absolute complaints before a surge can fire (default 5)
# GOOGLE_ALERTS_RSS_URLS=           # comma-separated Google Alerts RSS feed URLs
# FB_PAGE_TOKEN=                    # Meta Graph page token for Facebook page mentions
# IG_BUSINESS_ID=                   # Instagram business account id
# X_MONITOR_ENABLED=false           # poll X/Twitter for mentions
# X_BEARER_TOKEN=                   # X API bearer token
# X_DAILY_READ_BUDGET=2400          # max X post reads per day, to stay inside the plan quota (default 2400)
#
# ------------------------------------------------------------------------------
# Feature flags (Phases 4-7 — each gates a whole subsystem)
# ------------------------------------------------------------------------------
# MAINTENANCE_ENABLED=false         # planned-maintenance plans, tasks and windows, and the
#                                   # iCalendar/iMIP invites that go with them
# CAPACITY_ENABLED=false            # busy-hour PRB observations and the capacity advisories drawn
#                                   # from them. Deliberately its OWN flag and not MAINTENANCE_ENABLED:
#                                   # arming the maintenance calendar must not also open a capacity
#                                   # ingest path. Planning can run readings with the calendar off --
#                                   # every reading then states that planned outages were NOT excluded.
#                                   # An advisory is advice: it never schedules maintenance.
# UPLOADS_ENABLED=false             # file upload intake (contracts, capacity CSVs, complaint
#                                   # evidence). Rejected files are never written to disk.
# UPLOAD_DIR=                       # where accepted uploads are stored (unset = data/uploads).
#                                   # Never point this inside frontend/dist: every accepted
#                                   # file would become a URL. The code refuses that and warns.
# ICS_UID_DOMAIN=                   # right-hand side of a calendar invite UID (unset = noc.local).
#                                   # Changing it after invites have gone out gives attendees a
#                                   # DUPLICATE event rather than an update -- set it once.
# SCORECARDS_ENABLED=false          # vendor/MSP scorecards and dispute workflow
# INDIVIDUAL_METRICS_ENABLED=false  # per-engineer metrics; needs a DPIA before it may be turned on
# FAIRNESS_GAP_THRESHOLD=           # gap that trips a fairness warning on those metrics (unset = no check)
# PIR_ENABLED=false                 # post-incident reviews and action items
# CONTRACTS_ENABLED=false           # contract clause search and contract FAQ
# COMPLAINTS_ENABLED=false          # confidential relationship-complaint intake: classifier,
#                                   # manager reminders, 24-month free-text reduction, DPA s.26
#                                   # subject access. Deliberately its OWN flag and not
#                                   # CONTRACTS_ENABLED: turning on contract search must not
#                                   # also turn on a complaint intake.
# SUPPORT_DESK_ENABLED=true         # the multi-agent customer support desk (docs/SUPPORT_DESK.md):
#                                   # public complaint form, triage / resolver / action agents,
#                                   # escalation queue, evals. DEFAULT TRUE in this demo -- unlike the
#                                   # lanes above it sends nothing and its tools act on fixtures
#                                   # (config/support/accounts.yaml). false/0/no/off = every route 404s.
#                                   # Limits (refund KES 500, reversal KES 5,000 / 24h, re-credit one per
#                                   # 30 days, rate limit, thresholds) live in config/support/policy.yaml,
#                                   # not here: they are policy, reviewed as a file. Not to be confused
#                                   # with COMPLAINTS_ENABLED (staff complaints about vendors).
# REGULATORY_ENABLED=false          # regulatory notification tracking and deadlines
# HOUSEKEEPING_ENABLED=false        # retention, expiry and cleanup jobs
# HOUSEKEEPING_APPLY=false          # SECOND key: housekeeping only DELETES when this is true AND
#                                   # config/retention.yaml has posture.dry_run: false. Two keys on
#                                   # purpose -- the YAML is the document Legal signs off, this flag
#                                   # is the operator's decision, and neither party can start
#                                   # deleting operational records alone. With HOUSEKEEPING_ENABLED
#                                   # on and this off, the job reports what it WOULD delete.
# SLA_TERMS_PATH=                   # override for config/sla_terms.yaml (unset = that file)
# RETENTION_POLICY_PATH=            # override for config/retention.yaml (unset = that file). The
#                                   # YAML is the document Legal signs off; point this elsewhere only
#                                   # to test a draft policy, never to bypass the signed one.
# NOC_SEED_V2_DIR=                  # override for data/seed/v2/ used by noc-seed-v2 (unset = that dir)
#
# ------------------------------------------------------------------------------
# Memory (Phase 4 Lane 4C)
# ------------------------------------------------------------------------------
# MEMORY_ENABLED=false              # memory reads + consolidation jobs (expiry still runs under HOUSEKEEPING_ENABLED)
# MEMORY_PARTY_PRIORS_ENABLED=false # per-person memory priors; honoured ONLY with a DPIA reference in
#                                   # docs/COMPLIANCE.md AND AUTH_DISABLED=false
# MEMORY_EMBEDDINGS_ENABLED=false   # optional vector recall; needs the "rag" extra installed
#
# ------------------------------------------------------------------------------
# MCP (Phase 7)
# ------------------------------------------------------------------------------
# MCP_RUNTIME_ENABLED=false         # let agents call MCP tool cards at runtime
# OPENWEATHER_AGENT_KEY=            # key for the OpenWeather MCP card, if that card is exercised
#
# ------------------------------------------------------------------------------
# A2A (Phase 8)
# ------------------------------------------------------------------------------
# A2A_ENABLED=false                 # expose/consume agent-to-agent tasks
#
# ------------------------------------------------------------------------------
# Auth and runtime
# ------------------------------------------------------------------------------
# AUTH_DISABLED=true                # DEFAULT TRUE IN DEMO so the UI opens with no login.
#                                   # MUST be false in production — true means no authentication at all.
# NOC_ENV=demo                      # demo | production (default demo). Production tightens compliance gates.
# NOC_SESSION_SECRET=               # secret used to sign session cookies; required once AUTH_DISABLED=false
# CORS_ORIGINS=http://localhost:5173  # comma-separated allowed browser origins (default is the Vite dev server)
# ALERT_ENVELOPE_V2=false           # emit the v2 alert envelope shape instead of v1
# HANDOVER_REQUIRES_HITL=true       # DEFAULT TRUE: a shift handover must be approved by a human before it lands
# NOC_USE_TRUSTSTORE=false          # call truststore.inject_into_ssl() so Python uses the Windows cert store
#                                   # (fixes CERTIFICATE_VERIFY_FAILED behind a corporate TLS proxy; pip install truststore)
# NOC_SKIP_DOTENV=false             # set to 1 to skip .env loading entirely (the test suite sets this)
#
# ------------------------------------------------------------------------------
# Misc
# ------------------------------------------------------------------------------
# LEDGER_DIR=                       # directory for Excel shift ledgers (default: repo data dir)
# OTEL_EXPORTER_OTLP_ENDPOINT=      # OpenTelemetry collector endpoint. NOTHING IS EXPORTED TODAY: no
#                                   # opentelemetry-* package is a dependency of this project, so there is
#                                   # no SDK to build an exporter with. Spec 10.4 asks for the GenAI
#                                   # attribute NAMES, and llm/otel.py produces them (gen_ai.request.model,
#                                   # gen_ai.usage.input_tokens/output_tokens, error.type, ...) on one
#                                   # structured log line per llm_calls row. Setting this variable is not
#                                   # silent: llm/otel.py reads it and logs a WARNING, once per endpoint,
#                                   # saying the collector will receive nothing. llm.otel.exporter_state()
#                                   # returns the same answer in code.
#
# ------------------------------------------------------------------------------
# Shadow mode (write the rows, send nothing — for rehearsing a channel safely)
# ------------------------------------------------------------------------------
# BROADCAST_SHADOW=false            # record broadcasts as if sent, transmit nothing
# SMS_SHADOW=false                  # record SMS as if sent, transmit nothing
# SCORECARDS_SHADOW=false           # compute and store scorecards, publish nothing to vendors
